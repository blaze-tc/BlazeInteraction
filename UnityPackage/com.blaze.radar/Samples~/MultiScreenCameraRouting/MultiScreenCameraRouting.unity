  m_Text: "REFERENCE CAVE\n\nLEFT  \u2022  cyan  \u2022  elliptical P1\nFRONT  \u2022 
    amber  \u2022  crossing P1 + P2\nRIGHT  \u2022  violet  \u2022  elliptical P1\n\nPointer
    identity = (ScreenId, PointerId)\nPool = 16 prewarmed / 64 hard cap\nMove history
    = 10 Hz per key\nLive tables = unthrottled"
