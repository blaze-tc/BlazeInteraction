<Window x:Class="Blaze.Provider.CameraVision.CameraVisionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blaze.Provider.CameraVision"
        Title="CameraVision · 多人手部感应"
        Width="1440" Height="780" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Blaze.Provider.CameraVision;component/Resources/InteractionConsoleTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CalibrationHandleStyle" TargetType="Thumb">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Cursor" Value="SizeAll" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid>
                                <Ellipse Fill="#FFFFB020"
                                         Stroke="#FF08111D"
                                         StrokeThickness="2" />
                                <Ellipse Margin="5" Fill="White" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="PreviewWorkspace" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8" Margin="0">
                <Grid x:Name="RawPreviewHost" Background="Black">
                    <local:CameraImageSurface x:Name="RawCameraPreview" />
                    <Canvas x:Name="CalibrationOverlay" ClipToBounds="False">
                        <Polygon x:Name="CalibrationPolygon"
                                 Stroke="#FF00D4FF"
                                 StrokeThickness="2"
                                 Fill="#2200D4FF"
                                 IsHitTestVisible="False" />
                        <Thumb x:Name="CalibrationHandleP1" Tag="0"
                               Style="{StaticResource CalibrationHandleStyle}"
                               DragDelta="CalibrationHandle_DragDelta"
                               DragCompleted="CalibrationHandle_DragCompleted" />
                        <Thumb x:Name="CalibrationHandleP2" Tag="1"
                               Style="{StaticResource CalibrationHandleStyle}"
                               DragDelta="CalibrationHandle_DragDelta"
                               DragCompleted="CalibrationHandle_DragCompleted" />
                        <Thumb x:Name="CalibrationHandleP3" Tag="2"
                               Style="{StaticResource CalibrationHandleStyle}"
                               DragDelta="CalibrationHandle_DragDelta"
                               DragCompleted="CalibrationHandle_DragCompleted" />
                        <Thumb x:Name="CalibrationHandleP4" Tag="3"
                               Style="{StaticResource CalibrationHandleStyle}"
                               DragDelta="CalibrationHandle_DragDelta"
                               DragCompleted="CalibrationHandle_DragCompleted" />
                    </Canvas>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="10" Padding="9,5" CornerRadius="4"
                            Background="#CC08111D">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="摄像机画面 · 骨骼与区域控制" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="0"
                                       Text="拖动四个角点设置有效区域 · 区域外中心点不发送" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" Margin="0">
                <Grid Background="Black">
                    <local:CameraPointSurface x:Name="UnityPointPreview" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="10" Padding="8,4" CornerRadius="4"
                            Background="#CC08111D">
                        <TextBlock Text="Unity 输出预览 · 中心点 + 21 关节点" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="CameraConsoleTitle"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="#FF102A43"
                           Text="CameraVision 控制台" />
                <TextBlock Margin="0,4,0,14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="多人手部感应 · 通用 InteractionPoint 输出" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设备" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="摄像机" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceCombo"
                                      ItemsSource="{Binding Devices}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Index"
                                      SelectedValue="{Binding DeviceIndex, Mode=TwoWay}" />
                            <Button x:Name="RefreshDevicesButton"
                                    Grid.Column="1" Margin="8,0,0,0"
                                    Content="刷新"
                                    Command="{Binding RefreshDevicesCommand}" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="分辨率" />
                        <ComboBox x:Name="ResolutionCombo"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="帧率" />
                        <ComboBox x:Name="FrameRateCombo"
                                  ItemsSource="{Binding FrameRates}"
                                  SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MirrorCheck"
                                      VerticalAlignment="Center"
                                      Content="水平镜像"
                                      IsChecked="{Binding MirrorX}" />
                            <ComboBox x:Name="RotationCombo"
                                      Grid.Column="1"
                                      SelectedItem="{Binding Rotation}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding CapabilityWarning}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="识别" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="最大手数量" />
                            <TextBox x:Name="MaxHandsBox" Grid.Column="1" Text="{Binding MaxHands}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="中心跟踪点" />
                            <ComboBox x:Name="TrackingCombo" Grid.Row="1" Grid.Column="1"
                                      SelectedItem="{Binding TrackingPoint}" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="检测置信度" />
                            <TextBox x:Name="DetectionConfidenceBox" Grid.Row="2" Grid.Column="1"
                                     Text="{Binding MinDetectionConfidence}" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="跟踪置信度" />
                            <TextBox x:Name="TrackingConfidenceBox" Grid.Row="3" Grid.Column="1"
                                     Text="{Binding MinTrackingConfidence}" />
                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="EMA 平滑" />
                            <TextBox x:Name="SmoothingBox" Grid.Row="4" Grid.Column="1"
                                     Text="{Binding SmoothingFactor}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Unity 输出" />
                        <TextBlock Margin="0,0,0,8"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="透视换算后执行翻转，并按 Unity 当前 Surface 分辨率输出。" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="FlipXCheck"
                                      Margin="0,0,18,0"
                                      Content="翻转 X"
                                      IsChecked="{Binding FlipX}" />
                            <CheckBox x:Name="FlipYCheck"
                                      Content="翻转 Y"
                                      IsChecked="{Binding FlipY}" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Unity 输出宽度" />
                            <TextBlock x:Name="UnityOutputWidthText"
                                       Grid.Column="1"
                                       Text="{Binding UnityOutputWidth}" />
                            <TextBlock Grid.Row="1" Text="Unity 输出高度" />
                            <TextBlock x:Name="UnityOutputHeightText"
                                       Grid.Row="1" Grid.Column="1"
                                       Text="{Binding UnityOutputHeight}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="区域" />
                        <TextBlock Margin="0,0,0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="在左侧摄像机画面中直接拖动四个角点。拖动结束后立即保存。" />
                        <Button x:Name="ResetCalibrationButton"
                                HorizontalAlignment="Left"
                                Content="重置为完整画面"
                                Command="{Binding ResetCalibrationCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输出与状态" />
                        <UniformGrid Columns="2">
                            <TextBlock Text="Unity 连接" />
                            <TextBlock x:Name="UnityStatusText" Text="{Binding UnityConnected}" />
                            <TextBlock Text="摄像机连接" />
                            <TextBlock x:Name="CameraStatusText" Text="{Binding CameraStatus}" />
                            <TextBlock Text="实际分辨率" />
                            <TextBlock>
                                <Run Text="{Binding ActualWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding ActualHeight, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Camera FPS" />
                            <TextBlock x:Name="CameraFpsText"
                                       Text="{Binding CameraFramesPerSecond, StringFormat=F1}" />
                            <TextBlock Text="Inference FPS" />
                            <TextBlock x:Name="InferenceFpsText"
                                       Text="{Binding InferenceFramesPerSecond, StringFormat=F1}" />
                            <TextBlock Text="Output FPS" />
                            <TextBlock x:Name="OutputFpsText"
                                       Text="{Binding OutputFramesPerSecond, StringFormat=F1}" />
                            <TextBlock Text="Latency ms" />
                            <TextBlock x:Name="LatencyText"
                                       Text="{Binding InferenceLatencyMilliseconds, StringFormat=F1}" />
                            <TextBlock Text="检测手数量" />
                            <TextBlock x:Name="DetectedHandsText" Text="{Binding DetectedHandCount}" />
                            <TextBlock Text="采集/处理丢帧" />
                            <TextBlock x:Name="DroppedFramesText" Text="{Binding DroppedFrames}" />
                            <TextBlock Text="UI 已渲染帧" />
                            <TextBlock Text="{Binding UiRenderedFrames}" />
                            <TextBlock Text="UI 已替换旧帧" />
                            <TextBlock Text="{Binding UiSupersededFrames}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,0,0,10"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReconnectButton" Margin="0,0,8,0"
                            Content="重新连接" Command="{Binding ReconnectCommand}" />
                    <Button x:Name="ApplyButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="应用设置"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
