<Window x:Class="Yuexin.Radar.Bridge.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Yuexin.Radar.Bridge.Wpf.Controls"
        Title="RadarBridge · 多屏雷达控制台"
        Width="1600" Height="900" MinWidth="1120" MinHeight="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1725" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RADARBRIDGE" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="多屏幕 · 多雷达 · 融合诊断" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12283A" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding UnityStatus.IsConnected, StringFormat=Unity 连接：{0}}" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <Button Content="全部连接" Command="{Binding ConnectAllCommand}" Margin="0,0,6,0"/>
                    <Button Content="全部断开" Command="{Binding DisconnectAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="330" MinWidth="270"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Unity 屏幕" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" MaxHeight="230">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding UnityDisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EffectiveResolutionText}" Style="{StaticResource CaptionStyle}" Margin="0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding OnlineSensorCount, StringFormat=雷达 {0}}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="连接屏幕" Command="{Binding ConnectScreenCommand}" Margin="0,0,6,0"/>
                                <Button Content="断开屏幕" Command="{Binding DisconnectScreenCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="当前屏幕雷达" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Left"/>
                                <Button Content="＋" Command="{Binding AddSensorCommand}" Width="32" Padding="0" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding SelectedScreen.Sensors}" SelectedItem="{Binding SelectedSensor}" MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SourceMode}" Style="{StaticResource CaptionStyle}" Margin="0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding RuntimeState}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="连接所选" Command="{Binding ConnectSensorCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="断开所选" Command="{Binding DisconnectSensorCommand}" Margin="4,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="启动全部模拟" Command="{Binding StartAllSimulationCommand}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="删除雷达" Command="{Binding DeleteSensorCommand}" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="区域 1 · 原始雷达数据" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="仅观察选中雷达的物理原始点与有效点。" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#080F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                            <controls:RadarPointCloudView x:Name="RawRadarView"
                                                          Snapshot="{Binding SelectedSensor.Snapshot}"
                                                          MaximumRangeMeters="{Binding SelectedSensor.VisualizationRangeMeters}"
                                                          ShowRawPoints="True" ShowValidPoints="True" ShowClusters="False"
                                                          ShowFilterOverlay="False" ShowBlindZone="False" IsRegionEditable="False"/>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding SelectedSensor.Snapshot.RawPoints.Count, StringFormat=原始点：{0}}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="区域 2 · 屏幕融合输出" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="OutputRect、各雷达检测、融合目标与 Pointer。" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#080F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                            <controls:RadarScreenFusionView x:Name="ScreenFusionView"
                                                            Snapshot="{Binding SelectedScreen.LatestSnapshot}"
                                                            Sensors="{Binding SelectedScreen.Sensors}"
                                                            SelectedSensorId="{Binding SelectedSensor.SensorId}"/>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding SelectedScreen.FusedTargetCount, StringFormat=融合目标：{0}}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="0">
                <TabControl>
                    <TabItem Header="屏幕参数">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}">
                            <StackPanel Margin="4,10,4,4" IsEnabled="{Binding SelectedScreen}">
                                <TextBlock Text="{Binding SelectedScreen.UnityDisplayName}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="有效分辨率" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{Binding SelectedScreen.EffectiveResolutionText}" FontWeight="SemiBold"/>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0"><TextBlock Text="宽度" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedScreen.WidthPixels, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="高度" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedScreen.HeightPixels, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <Button Content="恢复 Unity 默认分辨率" Command="{Binding RestoreUnityResolutionCommand}" Margin="0,8,0,0"/>
                                <Separator/>
                                <TextBlock Text="融合" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="输出频率 (Hz)" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedScreen.OutputRateHz, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="数据最大年龄 (ms)" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedScreen.SensorDataMaxAgeMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="跨雷达融合距离 (px)" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedScreen.FusionDistancePixels, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="跟踪与交互" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0"><TextBlock Text="确认帧" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedScreen.ConfirmFrames, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="丢失帧" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedScreen.LostFrames, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="最大关联距离 (px)" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedScreen.MaximumAssociationDistancePixels, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="平滑系数" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedScreen.SmoothingAlpha, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="停留时长 (ms)" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedScreen.DwellMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="雷达参数">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}">
                            <StackPanel Margin="4,10,4,4" IsEnabled="{Binding SelectedSensor}">
                                <TextBlock Text="{Binding SelectedSensor.DisplayName}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="数据源 / 型号" Style="{StaticResource CaptionStyle}"/>
                                <ComboBox ItemsSource="{Binding SelectedSensor.AvailableModels}" SelectedItem="{Binding SelectedSensor.DeviceModel}"/>
                                <TextBlock Text="雷达 IP / 端口" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedSensor.RadarIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedSensor.Port, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
                                </Grid>
                                <CheckBox Content="自动重连" IsChecked="{Binding SelectedSensor.AutoReconnect}"/>
                                <Separator/>
                                <TextBlock Text="物理范围 / 变换" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0"><TextBlock Text="最小距离" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.MinimumDistanceMeters, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="最大距离" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.MaximumDistanceMeters, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="显示最大范围" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedSensor.VisualizationRangeMeters, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="旋转角度" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding SelectedSensor.RotationDegrees, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal"><CheckBox Content="翻转 X" IsChecked="{Binding SelectedSensor.FlipX}" Margin="0,5,16,0"/><CheckBox Content="翻转 Y" IsChecked="{Binding SelectedSensor.FlipY}" Margin="0,5,0,0"/></StackPanel>
                                <Separator/>
                                <TextBlock Text="输出矩形 (px)" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,4,4"><TextBlock Text="X" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.OutputX, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,4"><TextBlock Text="Y" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.OutputY, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,4,4,0"><TextBlock Text="宽" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.OutputWidth, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,0,0"><TextBlock Text="高" Style="{StaticResource CaptionStyle}"/><TextBox Text="{Binding SelectedSensor.OutputHeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                                <Separator/>
                                <TextBlock Text="区域 / 校准" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel Orientation="Horizontal"><Button Content="重置区域" Command="{Binding ResetRegionCommand}" Margin="0,0,5,0"/><Button Content="添加屏蔽" Command="{Binding AddMaskedRegionCommand}"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="开始标定" Command="{Binding BeginCalibrationCommand}" Margin="0,0,5,0"/><Button Content="采集点" Command="{Binding CaptureCalibrationPointCommand}" Margin="0,0,5,0"/><Button Content="保存" Command="{Binding SaveCalibrationCommand}"/></StackPanel>
                                <TextBlock Text="{Binding SelectedSensor.CalibrationStatus}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0"/>
                                <Separator/>
                                <TextBlock Text="录制 / 回放" Style="{StaticResource SectionTitleStyle}"/>
                                <Button Content="开始录制" Click="OnStartRecordingClick"/><Button Content="停止录制" Click="OnStopRecordingClick" Margin="0,6,0,0"/>
                                <Button Content="选择回放文件" Click="OnReplayClick" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="暂停" Click="OnPauseReplayClick" Margin="0,0,5,0"/><Button Content="继续" Click="OnResumeReplayClick" Margin="0,0,5,0"/><Button Content="停止" Click="OnStopReplayClick"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="14,0,14,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <TextBox Width="130" Text="{Binding SelectedLogScreenId, UpdateSourceTrigger=PropertyChanged}" ToolTip="屏幕筛选；* 表示全部" Margin="0,0,6,0"/>
                    <TextBox Width="130" Text="{Binding SelectedLogSensorId, UpdateSourceTrigger=PropertyChanged}" ToolTip="雷达筛选；* 表示全部"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding VisibleLogEntries}" FontFamily="Cascadia Mono" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Margin="18,0" Text="屏幕配置由 Unity 拓扑同步；日志上限 500 条。" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
    </Grid>
</Window>
