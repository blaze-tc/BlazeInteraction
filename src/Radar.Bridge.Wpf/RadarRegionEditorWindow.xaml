<Window x:Class="Yuexin.Radar.Bridge.Wpf.RadarRegionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Yuexin.Radar.Bridge.Wpf.Controls"
        x:Name="EditorWindow"
        Title="RadarBridge · 拉框精细编辑"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Background="#0B1725" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="拉框精细编辑" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding DisplayName, StringFormat=当前雷达：{0}}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EditorRangeMeters, ElementName=EditorWindow, StringFormat=预览范围：{0:0.00} m}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                    <Button Content="放大" Click="OnZoomIn" Margin="0,0,6,0" ToolTip="放大画布细节；不修改雷达参数"/>
                    <Button Content="缩小" Click="OnZoomOut" Margin="0,0,6,0" ToolTip="缩小画布以观察更大范围"/>
                    <Button Content="适应拉框" Click="OnFitRegion" Margin="0,0,6,0" ToolTip="显示完整拉框并保留边缘空间"/>
                    <Button Content="参数范围" Click="OnUseConfiguredRange" Margin="0,0,6,0" ToolTip="将预览恢复为雷达参数中的显示最大范围"/>
                    <Button Content="居中" Click="OnCenterViewport" Margin="0,0,6,0" ToolTip="清除画布平移并恢复雷达原点居中"/>
                    <Button Content="关闭" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="#080F19" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <controls:RadarPointCloudView x:Name="RegionEditorView"
                                          Snapshot="{Binding Snapshot}"
                                          MaximumRangeMeters="{Binding EditorRangeMeters, ElementName=EditorWindow}"
                                          RegionVertices="{Binding RegionVertices}"
                                          MaskedRegions="{Binding MaskedPolygons}"
                                          LeftEdgeDeadZoneMeters="{Binding LeftEdgeDeadZoneMeters}"
                                          RightEdgeDeadZoneMeters="{Binding RightEdgeDeadZoneMeters}"
                                          TopEdgeDeadZoneMeters="{Binding TopEdgeDeadZoneMeters}"
                                          BottomEdgeDeadZoneMeters="{Binding BottomEdgeDeadZoneMeters}"
                                          ShowRawPoints="True" ShowValidPoints="True" ShowClusters="False"
                                          ShowFilterOverlay="True" ShowBlindZone="False" IsRegionEditable="True" IsPanEnabled="True"
                                          RegionVertexMoved="OnRegionVertexMoved"
                                          PreviewMouseWheel="OnPreviewMouseWheel"/>
        </Border>

        <TextBlock Grid.Row="2" Margin="18,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="灰色为原始点，青色为过滤后点，橙色带为边线过滤区；拖动绿色顶点调整区域，按住空白处拖动画布。平移与缩放都不改变雷达参数和 Unity 坐标。"/>
    </Grid>
</Window>
