<UserControl x:Class="Blaze.Interaction.Bridge.Wpf.ProviderHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UnityConnectionStatus"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding UnityStatus}" />
            <TextBlock Grid.Column="2"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding ProviderName}" />
            <TextBlock x:Name="ProviderConnectionStatus"
                       Grid.Column="4"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding ProviderStatus}" />
            <Button x:Name="ReturnToProviderSelectionButton"
                    Grid.Column="6"
                    Command="{Binding ReturnToSelectionCommand}"
                    Content="返回选择感应设备" />
        </Grid>
    </Border>
</UserControl>
