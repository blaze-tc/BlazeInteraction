+absl::Status ImageToTensorFrameBufferConverter::WarpRgbToTensor(
+    std::shared_ptr<const FrameBuffer> input, const RotatedRect& roi,
+    float range_min, float range_max, Tensor& output_tensor) {
+  RET_CHECK(input->format() == FrameBuffer::Format::kRGB);
+  RET_CHECK_EQ(input->plane_count(), 1);
+  RET_CHECK(tensor_type_ == Tensor::ElementType::kFloat32);
+
+  const auto input_dims = input->dimension();
+  const auto stride = input->plane(0).stride();
+  const uint8_t* pixels = input->plane(0).buffer();
+  const auto& output_shape = output_tensor.shape();
+  const int output_height = output_shape.dims[1];
+  const int output_width = output_shape.dims[2];
+  auto output_view = output_tensor.GetCpuWriteView();
+  float* output = output_view.buffer<float>();
+
+  constexpr float kInputImageRangeMin = 0.0f;
+  constexpr float kInputImageRangeMax = 255.0f;
+  MP_ASSIGN_OR_RETURN(
+      auto transform,
+      GetValueRangeTransformation(kInputImageRangeMin, kInputImageRangeMax,
+                                  range_min, range_max));
+
+  const float cosine = std::cos(roi.rotation);
+  const float sine = std::sin(roi.rotation);
+  auto sample = [&](int x, int y, int channel) -> float {
+    if (border_mode_ == BorderMode::kReplicate) {
+      x = std::max(0, std::min(x, input_dims.width - 1));
+      y = std::max(0, std::min(y, input_dims.height - 1));
+    } else if (x < 0 || y < 0 || x >= input_dims.width ||
+               y >= input_dims.height) {
+      return 0.0f;
+    }
+    return pixels[static_cast<size_t>(y) * stride.row_stride_bytes +
+                  static_cast<size_t>(x) * stride.pixel_stride_bytes +
+                  channel];
+  };
+
+  for (int y = 0; y < output_height; ++y) {
+    const float local_y =
+        ((static_cast<float>(y) + 0.5f) / output_height - 0.5f) * roi.height;
+    for (int x = 0; x < output_width; ++x) {
+      const float local_x =
+          ((static_cast<float>(x) + 0.5f) / output_width - 0.5f) * roi.width;
+      const float source_x =
+          roi.center_x + cosine * local_x - sine * local_y;
+      const float source_y =
+          roi.center_y + sine * local_x + cosine * local_y;
+      const int x0 = static_cast<int>(std::floor(source_x));
+      const int y0 = static_cast<int>(std::floor(source_y));
+      const float x_weight = source_x - x0;
+      const float y_weight = source_y - y0;
+      for (int channel = 0; channel < 3; ++channel) {
+        const float top = sample(x0, y0, channel) * (1.0f - x_weight) +
+                          sample(x0 + 1, y0, channel) * x_weight;
+        const float bottom = sample(x0, y0 + 1, channel) *
+                                 (1.0f - x_weight) +
+                             sample(x0 + 1, y0 + 1, channel) * x_weight;
+        const float value = top * (1.0f - y_weight) + bottom * y_weight;
+        *output++ = value * transform.scale + transform.offset;
+      }
+    }
+  }
+  return absl::OkStatus();
+}
