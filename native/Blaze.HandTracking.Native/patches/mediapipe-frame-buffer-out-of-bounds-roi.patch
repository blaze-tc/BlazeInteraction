+bool RoiExtendsBeyondInput(const RotatedRect& roi,
+                           const FrameBuffer::Dimension& input_dims) {
+  const float cosine = std::abs(std::cos(roi.rotation));
+  const float sine = std::abs(std::sin(roi.rotation));
+  const float extent_x = (cosine * roi.width + sine * roi.height) * 0.5f;
+  const float extent_y = (sine * roi.width + cosine * roi.height) * 0.5f;
+  return roi.center_x - extent_x < 0.0f ||
+         roi.center_y - extent_y < 0.0f ||
+         roi.center_x + extent_x > input_dims.width ||
+         roi.center_y + extent_y > input_dims.height;
+}
